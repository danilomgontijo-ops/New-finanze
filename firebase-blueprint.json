{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the authenticated user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "lastLoginAt": { "type": "string", "description": "ISO string of last login" }
      },
      "required": ["email"]
    },
    "Demand": {
      "title": "Fiscal Demand",
      "description": "Fiscal demand record managed by the user",
      "type": "object",
      "properties": {
        "ano": { "type": "string", "description": "Year of demand" },
        "nFiscalizacao": { "type": "string", "description": "Inspection number" },
        "municipio": { "type": "string", "description": "Municipality name" },
        "modalidade": { "type": "string", "description": "Modality type" },
        "tema": { "type": "string", "description": "Theme or subject" },
        "valor": { "type": "number", "description": "Monetary value" },
        "status": { "type": "string", "description": "Current status" },
        "representacaoExterna": { "type": "array", "description": "External representation tags" },
        "dataReqExterno": { "type": "string", "description": "Date of external request" },
        "requerimentoExterno": { "type": "string", "description": "External request details" },
        "encaminhamentoProcessual": { "type": "string", "description": "Procedural forwarding info" },
        "observacoes": { "type": "string", "description": "Notes / observations HTML" },
        "resumoRelatorio": { "type": "string", "description": "Report summary" },
        "relatorioNomeArquivo": { "type": "string", "description": "Name(s) of attached report files" },
        "relatorioTextoCompleto": { "type": "string", "description": "Extracted text content from reports" },
        "relatorioArquivos": { "type": "array", "description": "List of attached report files with metadata and download URLs" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["municipio", "status"]
    },
    "AICacheEntry": {
      "title": "AI Smart Cache Entry",
      "description": "Cached prompt and answer pairs for token optimization and instant retrieval",
      "type": "object",
      "properties": {
        "normalizedKey": { "type": "string", "description": "Normalized query and context key" },
        "type": { "type": "string", "description": "Type of query: consultoria or achado" },
        "queryText": { "type": "string", "description": "Original query or situation text" },
        "responseHtml": { "type": "string", "description": "Generated or cached markdown/HTML response" },
        "demandsFingerprint": { "type": "string", "description": "Fingerprint of demands context used" },
        "totalDemandsContext": { "type": "number", "description": "Total demands included in context" },
        "createdAt": { "type": "string", "description": "Date string when generated" },
        "timestamp": { "type": "number", "description": "Epoch timestamp" },
        "savedTokensEstimate": { "type": "number", "description": "Estimated tokens saved per hit" },
        "useCount": { "type": "number", "description": "Number of times retrieved from cache" }
      },
      "required": ["normalizedKey", "queryText", "responseHtml"]
    },
    "SavedConsultation": {
      "title": "Saved AI Consultation",
      "description": "Saved question and answer history from AI Consultant",
      "type": "object",
      "properties": {
        "pergunta": { "type": "string", "description": "User question" },
        "respostaHtml": { "type": "string", "description": "AI response HTML" },
        "createdAt": { "type": "string", "description": "Created at date string" },
        "totalDemandsContext": { "type": "number", "description": "Context demands count" }
      },
      "required": ["pergunta", "respostaHtml"]
    },
    "SavedFinding": {
      "title": "Saved Audit Finding",
      "description": "Saved audit findings and standard drafts",
      "type": "object",
      "properties": {
        "titulo": { "type": "string", "description": "Finding title" },
        "conteudoHtml": { "type": "string", "description": "Finding HTML content" },
        "createdAt": { "type": "string", "description": "Created at date string" },
        "tema": { "type": "string", "description": "Theme or subject" }
      },
      "required": ["titulo", "conteudoHtml"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/demands/{demandId}": {
      "schema": { "$ref": "#/entities/Demand" },
      "description": "User isolated demands collection"
    },
    "/users/{userId}/ai_cache/{cacheId}": {
      "schema": { "$ref": "#/entities/AICacheEntry" },
      "description": "User AI query cache for instant responses and token savings"
    },
    "/users/{userId}/saved_consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/SavedConsultation" },
      "description": "User saved consultations collection"
    },
    "/users/{userId}/saved_findings/{findingId}": {
      "schema": { "$ref": "#/entities/SavedFinding" },
      "description": "User saved audit findings collection"
    }
  }
}
